# ===== Firebase =====
# Caminho do JSON da conta de serviço (Console > Configurações do projeto > Contas de serviço > Gerar nova chave)
FIREBASE_CREDENTIALS=./firebase-credentials.json

# ===== Servidor =====
# Endereços do frontend autorizados (separe por vírgula). Abra o site SEMPRE por um destes.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Chave secreta que protege o hash dos códigos de e-mail. Gere a sua:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# ===== Login =====
# true = só entra quem tem e-mail confirmado (contas criadas pelo cadastro do sistema já nascem confirmadas)
REQUIRE_EMAIL_VERIFIED=true

# ===== E-mail do código de cadastro =====
# SEM SMTP_HOST o código NÃO é enviado: ele só aparece no terminal do uvicorn (modo desenvolvimento).
# Para enviar e-mail de verdade (exemplo Gmail: ative a verificação em 2 etapas e crie uma "Senha de app"):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASSWORD=senha-de-app-de-16-letras
# SMTP_FROM=C.A.S.A. <seuemail@gmail.com>

# ===== Regras do sistema =====
MAX_CATEGORIAS=3
MAX_BOTOES_POR_CATEGORIA=5
BATERIA_BAIXA_PCT=20
DEVICE_OFFLINE_MINUTOS=10
