# Caminho do JSON da conta de serviço (Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave)
FIREBASE_CREDENTIALS=./firebase-credentials.json
CORS_ORIGINS=http://localhost:3000
REQUIRE_EMAIL_VERIFIED=true      # RF02: só entra quem confirmou o e-mail (link do Firebase)
MAX_CATEGORIAS=3
MAX_BOTOES_POR_CATEGORIA=5
